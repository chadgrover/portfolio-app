---
import ProfileLinkMark from '../components/ProfileLinkMark.astro';
import Page from '../layouts/Page.astro';
import { supportedLanguages } from '../lib/i18n/constants';
import { interfaceText, languageNames } from '../lib/i18n/interface-text';
import type { Language } from '../lib/i18n/types';
import { fontFaceUrl, type FontFace } from '../lib/fonts/faces';
import { createHomePage } from '../lib/home-page';
import { createHomePageMetadata } from '../lib/page-metadata';
import { getPortfolioContent } from '../lib/portfolio-content/entries';

export const getStaticPaths = () => supportedLanguages.map((language) => ({ params: { language } }));

const language = Astro.params.language as Language;
const content = await getPortfolioContent(language);
const homePage = createHomePage(language, content, (await getPortfolioContent('en')).homePage.role);
const text = interfaceText[language];
const fontFacesUsed: FontFace[] = language === 'ja' ? ['japanese-name', 'latin'] : ['latin'];
---
<Page language={language} metadata={createHomePageMetadata(language, content.latinScriptName, homePage.introduction)} class="home" style={`--name-columns: ${homePage.nameColumns}`}>
  {fontFacesUsed.map((face) => (
    <link slot="head" rel="preload" href={fontFaceUrl(face)} as="font" type="font/woff2" crossorigin />
  ))}
  <header slot="header" class="masthead">
    <nav aria-label={text.languageSwitchLabel} class="language-switch">
      {supportedLanguages.map((destination) => (
        <a href={`/${destination}/`} lang={destination} hreflang={destination}
          aria-current={language === destination ? 'page' : undefined}>
          {languageNames[destination]}{language === destination && <span class="current-language-underline" />}
        </a>
      ))}
    </nav>
  </header>
  <div class="identity">
    <h1 class="name">{homePage.nameLines.map((line, index) => <>{index > 0 && ' '}<span class="name-line">{line}</span></>)}</h1>
  </div>
  <div class="spine">
    {homePage.latinScriptName && <p class="spine-name" lang="en" aria-hidden="true" translate="no">{homePage.latinScriptName}</p>}
  </div>
  <div class="about">
    <p class="role">
      {homePage.role}
      {homePage.englishRole && <span class="role-english" lang="en">{homePage.englishRole}</span>}
    </p>
    <p class="introduction">{homePage.introduction}</p>
  </div>
  {homePage.profileLinks.length > 0 && (
    <ul class="profile-links links-on-rule" role="list">
      {homePage.profileLinks.map(({ id, url, accessibleName, printedAddress }) => (
        <li>
          <a href={url} aria-label={accessibleName} data-printed-address={printedAddress}>
            <ProfileLinkMark profileLinkId={id} />
          </a>
        </li>
      ))}
    </ul>
  )}
</Page>

<style>
  @view-transition {
    navigation: auto;
  }

  @keyframes slide-bar-in {
    from {
      translate: calc(-100% - var(--gutter)) 0;
    }
  }

  :global(main.home) {
    --measure: 36rem;
    --name-advance: 0.7;
    --name-max: 10.75rem;
    max-width: none;
    margin: 0;
    padding: 5.5rem var(--gutter) 2.5rem;
    min-height: 100svh;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    overflow-wrap: normal;
  }

  :global(main.home)::before {
    content: "";
    block-size: 0.875rem;
    inline-size: min(70%, var(--measure) + var(--gutter));
    margin-inline-start: calc(-1 * var(--gutter));
    margin-block-end: 1.75rem;
    background: var(--type);
    animation: slide-bar-in 700ms var(--ease-out);
  }

  .masthead {
    position: absolute;
    inset-block-start: 1.25rem;
    inset-inline-end: var(--gutter);
    z-index: 1;
  }

  .language-switch {
    display: flex;
    gap: 1.75rem;
    margin: 0;
  }

  .language-switch a {
    position: relative;
    display: block;
    padding-block: 0.5rem 0.375rem;
    color: var(--type);
    font-family: var(--latin);
    font-size: 0.9375rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    padding-inline-start: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    border-block-end: 3px solid transparent;
    transition: border-color 200ms var(--ease-out);
  }

  .language-switch a:lang(ja) {
    font-family: var(--japanese);
    letter-spacing: 0.08em;
    padding-inline-start: 0.08em;
  }

  .language-switch a:hover {
    border-block-end-color: var(--secondary);
  }

  .current-language-underline {
    position: absolute;
    inset-inline: 0;
    inset-block-end: -3px;
    block-size: 3px;
    background: var(--type);
    view-transition-name: current-language;
  }

  :global(::view-transition-group(current-language)) {
    animation-duration: 300ms;
    animation-timing-function: var(--ease-out);
  }

  .language-switch a:focus-visible {
    outline: 3px solid var(--press);
    outline-offset: 6px;
  }

  .identity {
    container-type: inline-size;
  }

  :global(main.home:lang(ja)) {
    --name-advance: 1.05;
    --name-max: 8.25rem;
  }

  .name {
    margin: 0;
    font-family: var(--latin);
    font-size: min(var(--name-max), 100cqi / (var(--name-columns) * var(--name-advance)));
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--type);
  }

  .name:lang(ja) {
    font-family: "Noto Sans JP Name", var(--japanese);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: 0.02em;
  }

  .role:lang(ja),
  .introduction:lang(ja) {
    word-break: auto-phrase;
  }

  .name-line {
    display: block;
    white-space: nowrap;
  }

  .spine-name {
    max-inline-size: var(--measure);
    margin: 0.875rem 0 0;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--hairline);
    font-family: var(--latin);
    font-size: 0.9375rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .about {
    max-inline-size: var(--measure);
    margin-block-start: 2rem;
  }

  .role {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.45;
    color: var(--type);
    text-wrap: balance;
  }

  .role:lang(en) {
    font-family: var(--latin);
    font-weight: 600;
    font-size: 1.5rem;
  }

  .role-english {
    display: block;
    margin-block-start: 0.375rem;
    font-family: var(--latin);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .introduction {
    max-inline-size: 34em;
    margin: 1.25rem 0 0;
    font-size: 1rem;
    line-height: 1.95;
    color: var(--body);
    text-wrap: pretty;
  }

  .introduction:lang(en) {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .profile-links {
    --profile-link-mark-size: 2rem;
    max-inline-size: var(--measure);
    margin-block-start: 2rem;
    gap: 0;
  }

  .profile-links a {
    position: relative;
    padding: var(--profile-link-mark-size);
    outline-offset: -3px;
  }

  .profile-links a::before {
    content: "";
    position: absolute;
    inset-block-start: -6px;
    inset-inline: 0;
    block-size: 6px;
    background: var(--press);
    scale: 1 0.5;
    transform-origin: bottom;
    transition: scale 200ms var(--ease-out);
  }

  .profile-links a:hover::before {
    scale: 1;
  }

  @media (width < 80rem) and (height <= 36rem) {
    :global(main.home) {
      min-height: 0;
      padding-block-start: 0;
    }

    .masthead {
      position: static;
      display: flex;
      justify-content: flex-end;
      padding: 1rem var(--gutter) 0;
    }

    :global(main.home)::before {
      block-size: 0.625rem;
      inline-size: 50%;
      margin-block-end: 0.5rem;
    }

    .name {
      font-size: min(var(--name-max), 100cqi / (var(--name-columns) * var(--name-advance)), 10svh);
    }

    .spine-name {
      margin-block-start: 0.5rem;
      padding-block-start: 0.5rem;
      line-height: 1.2;
    }

    .about {
      margin-block-start: 0.75rem;
    }

    .role-english {
      margin-block-start: 0.125rem;
    }

    .introduction {
      margin-block-start: 0.5rem;
      line-height: 1.8;
    }

    .profile-links {
      margin-block-start: 0.75rem;
    }
  }

  @media screen and (min-width: 80rem) {
    :global(main.home) {
      --gap: clamp(3rem, 8vw, 7.5rem);
      --name-column-min: 43rem;
      --name-column-max: calc(var(--name-columns) * var(--name-advance) * var(--name-max));
      padding: 0;
      grid-template-columns:
        var(--gutter) minmax(0, var(--name-column-max)) 3rem minmax(var(--gap), 1fr)
        clamp(20rem, 100vw - 2 * var(--gutter) - 3rem - var(--gap) - var(--name-column-min), 30.5rem) var(--gutter);
      grid-template-rows:
        clamp(6rem, 14.6svh, 8.25rem) 1.375rem clamp(2.5rem, 7.3svh, 4.125rem)
        auto 1fr auto clamp(3rem, 10svh, 6rem);
      align-content: stretch;
    }

    :global(main.home)::before {
      grid-column: 1 / 3;
      grid-row: 2;
      block-size: auto;
      inline-size: 88%;
      margin: 0;
    }

    :global(main.home)::after {
      content: "";
      grid-column: 2;
      grid-row: 6;
      align-self: start;
      inline-size: 78%;
      block-size: 6px;
      background: var(--bar-dim);
      animation: slide-bar-in 600ms var(--ease-out) 120ms backwards;
    }

    .masthead {
      inset-block-start: 2.25rem;
    }

    .identity {
      grid-column: 2;
      grid-row: 4;
      margin-inline-start: -0.375rem;
    }

    .spine {
      grid-column: 3;
      grid-row: 2 / 7;
      display: flex;
      align-items: flex-end;
      border-inline-end: 1px solid var(--hairline);
    }

    .spine-name {
      max-inline-size: none;
      margin: 0;
      padding: 0;
      border: 0;
      writing-mode: vertical-rl;
      rotate: 180deg;
      font-size: 1.875rem;
      letter-spacing: 0.42em;
      color: var(--type);
      white-space: nowrap;
    }

    .about {
      grid-column: 5;
      grid-row: 4 / 6;
      align-self: end;
      margin-block: 0 clamp(2.5rem, 9svh, 6rem);
      padding-block-start: 1.875rem;
      border-block-start: 1px solid var(--hairline);
    }

    .role {
      font-size: 1.5rem;
    }

    .role:lang(en) {
      font-size: 1.625rem;
    }

    .profile-links {
      grid-column: 5;
      grid-row: 6;
      margin: 0;
    }
  }

  @media print {
    @page {
      margin: 15mm;
    }

    :global(main.home) {
      min-height: auto;
      padding-block: 0;
    }

    :global(main.home)::before {
      animation: none;
      print-color-adjust: exact;
    }

    .masthead,
    .profile-links a::before,
    .profile-links :global(.profile-link-mark) {
      display: none;
    }

    .profile-links {
      column-gap: 2rem;
    }

    .profile-links a {
      padding: 0.875rem 0 0.5rem;
    }

    .profile-links a::after {
      content: attr(data-printed-address);
      overflow-wrap: anywhere;
    }
  }

  @media (forced-colors: active) {
    .language-switch a {
      border-block-end: 0;
      padding-block-end: calc(0.375rem + 3px);
    }

    .current-language-underline {
      inset-block-end: 0;
      forced-color-adjust: none;
      background: LinkText;
    }

    .profile-links a::before {
      forced-color-adjust: none;
      background: LinkText;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }

    .language-switch a,
    .profile-links a::before {
      transition: none;
    }

    :global(main.home)::before,
    :global(main.home)::after {
      animation: none;
    }
  }
</style>
