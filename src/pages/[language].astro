---
import ProfileLinkMark from '../components/ProfileLinkMark.astro';
import Page from '../layouts/Page.astro';
import { supportedLanguages } from '../lib/i18n/constants';
import { interfaceText, languageNames } from '../lib/i18n/interface-text';
import type { Language } from '../lib/i18n/types';
import { fontFaceUrl, type FontFace } from '../lib/fonts/faces';
import { homePageMetadata } from '../lib/page-metadata';
import { portfolioContentFor, profileLinks } from '../lib/portfolio-content/entries';

export const getStaticPaths = () => supportedLanguages.map((language) => ({ params: { language } }));

const language = Astro.params.language as Language;
const { hero } = (await portfolioContentFor(language)).home;
const englishHero = language === 'en' ? undefined : (await portfolioContentFor('en')).home.hero;
const text = interfaceText[language];
const nameLines = hero.displayName.split(/\s+/u);
const nameColumns = Math.max(...nameLines.map((line) => [...line].length));
const fontFacesUsed: FontFace[] = language === 'ja' ? ['japanese-name', 'latin'] : ['latin'];
---
<Page language={language} metadata={await homePageMetadata(language)} class="home">
  {fontFacesUsed.map((face) => (
    <link slot="head" rel="preload" href={fontFaceUrl(face)} as="font" type="font/woff2" crossorigin />
  ))}
  <header slot="header" class="masthead">
    <nav aria-label={text.languageSwitchLabel} class="language-switch">
      {supportedLanguages.map((destination) => (
        <a href={`/${destination}/`} lang={destination} hreflang={destination}
          aria-current={language === destination ? 'page' : undefined}>{languageNames[destination]}</a>
      ))}
    </nav>
  </header>
  <div class="identity" style={`--name-columns: ${nameColumns}`}>
    <h1 class="name">{nameLines.map((line, index) => <>{index > 0 && ' '}<span class="name-line">{line}</span></>)}</h1>
  </div>
  <div class="spine">
    {englishHero && <p class="spine-name" lang="en" aria-hidden="true" translate="no">{englishHero.displayName}</p>}
  </div>
  <div class="about">
    <p class="role">
      {hero.role}
      {englishHero && <span class="role-english" lang="en">{englishHero.role}</span>}
    </p>
    <p class="introduction">{hero.introduction}</p>
  </div>
  <ul class="profile-links links-on-rule" role="list">
    {(await profileLinks()).map(({ id, name, url }) => (
      <li>
        <a href={url} aria-label={text.profileLinkLabel({ profileLink: name })}>
          <ProfileLinkMark profileLinkId={id} />
          <span lang="en" translate="no">{name}</span>
        </a>
      </li>
    ))}
  </ul>
</Page>

<style>
  :global(main.home) {
    --measure: 36rem;
    max-width: none;
    margin: 0;
    padding: 5.5rem var(--gutter) 2.5rem;
    min-height: 100svh;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    overflow-wrap: normal;
  }

  :global(main.home)::before {
    content: "";
    block-size: 0.875rem;
    inline-size: min(70%, var(--measure) + var(--gutter));
    margin-inline-start: calc(-1 * var(--gutter));
    margin-block-end: 1.75rem;
    background: var(--type);
  }

  .masthead {
    position: absolute;
    inset-block-start: 1.25rem;
    inset-inline-end: var(--gutter);
    z-index: 1;
  }

  .language-switch {
    display: flex;
    gap: 1.75rem;
    margin: 0;
  }

  .language-switch a {
    display: block;
    padding-block: 0.5rem 0.375rem;
    color: var(--type);
    font-family: var(--latin);
    font-size: 0.9375rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    border-block-end: 3px solid transparent;
    transition: border-color 200ms var(--ease-out);
  }

  .language-switch a:lang(ja) {
    font-family: var(--japanese);
    letter-spacing: 0.08em;
  }

  .language-switch a:hover {
    border-block-end-color: var(--secondary);
  }

  .language-switch a[aria-current="page"] {
    border-block-end-color: var(--type);
  }

  .language-switch a:focus-visible {
    outline: 3px solid var(--press);
    outline-offset: 6px;
  }

  .identity {
    container-type: inline-size;
  }

  .name {
    --name-advance: 0.7;
    --name-max: 10.75rem;
    margin: 0;
    font-family: var(--latin);
    font-size: min(var(--name-max), 100cqi / (var(--name-columns) * var(--name-advance)));
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--type);
  }

  .name:lang(ja) {
    --name-advance: 1.05;
    --name-max: 8.25rem;
    font-family: "Noto Sans JP Name", var(--japanese);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: 0.02em;
  }

  .role:lang(ja),
  .introduction:lang(ja) {
    word-break: auto-phrase;
  }

  .name-line {
    display: block;
    white-space: nowrap;
  }

  .spine-name {
    max-inline-size: var(--measure);
    margin: 0.875rem 0 0;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--hairline);
    font-family: var(--latin);
    font-size: 0.9375rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .about {
    max-inline-size: var(--measure);
    margin-block-start: 2rem;
  }

  .role {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.45;
    color: var(--type);
    text-wrap: balance;
  }

  .role:lang(en) {
    font-family: var(--latin);
    font-weight: 600;
    font-size: 1.5rem;
  }

  .role-english {
    display: block;
    margin-block-start: 0.375rem;
    font-family: var(--latin);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .introduction {
    max-inline-size: 34em;
    margin: 1.25rem 0 0;
    font-size: 1rem;
    line-height: 1.95;
    color: var(--body);
    text-wrap: pretty;
  }

  .introduction:lang(en) {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .profile-links {
    max-inline-size: var(--measure);
    margin-block-start: 2rem;
  }

  @media (width < 80rem) and (height <= 36rem) {
    :global(main.home) {
      min-height: 0;
      padding-block-start: 0.25rem;
    }

    .masthead {
      position: static;
      display: flex;
      justify-content: flex-end;
      padding: 1rem var(--gutter) 0;
    }

    :global(main.home)::before {
      block-size: 0.625rem;
      inline-size: 50%;
      margin-block-end: 0.75rem;
    }

    .name {
      font-size: min(var(--name-max), 100cqi / (var(--name-columns) * var(--name-advance)), 10svh);
    }

    .spine-name {
      margin-block-start: 0.5rem;
      padding-block-start: 0.5rem;
      line-height: 1.2;
    }

    .about {
      margin-block-start: 1rem;
    }

    .role-english {
      margin-block-start: 0.125rem;
    }

    .introduction {
      margin-block-start: 0.75rem;
      line-height: 1.8;
    }

    .profile-links {
      margin-block-start: 1.25rem;
    }

    .profile-links a {
      padding-block-start: 0.625rem;
    }
  }

  @media (min-width: 80rem) {
    :global(main.home) {
      --gap: clamp(3rem, 8vw, 7.5rem);
      --name-column-min: 43rem;
      padding: 0;
      grid-template-columns:
        var(--gutter) minmax(0, 1fr) 3rem var(--gap)
        clamp(20rem, 100vw - 2 * var(--gutter) - 3rem - var(--gap) - var(--name-column-min), 30.5rem) var(--gutter);
      grid-template-rows:
        clamp(6rem, 14.6svh, 8.25rem) 1.375rem clamp(2.5rem, 7.3svh, 4.125rem)
        auto 1fr auto clamp(3rem, 10svh, 6rem);
      align-content: stretch;
    }

    :global(main.home)::before {
      grid-column: 1 / 3;
      grid-row: 2;
      block-size: auto;
      inline-size: 88%;
      margin: 0;
    }

    :global(main.home)::after {
      content: "";
      grid-column: 2;
      grid-row: 6;
      align-self: start;
      inline-size: 78%;
      block-size: 6px;
      background: var(--bar-dim);
    }

    .masthead {
      inset-block-start: 2.25rem;
    }

    .identity {
      grid-column: 2;
      grid-row: 4;
      margin-inline-start: -0.375rem;
    }

    .spine {
      grid-column: 3;
      grid-row: 2 / 7;
      display: flex;
      align-items: flex-end;
      border-inline-end: 1px solid var(--hairline);
    }

    .spine-name {
      max-inline-size: none;
      margin: 0;
      padding: 0;
      border: 0;
      writing-mode: vertical-rl;
      rotate: 180deg;
      font-size: 1.875rem;
      letter-spacing: 0.42em;
      color: var(--type);
      white-space: nowrap;
    }

    .about {
      grid-column: 5;
      grid-row: 4 / 6;
      align-self: end;
      margin-block: 0 clamp(2.5rem, 9svh, 6rem);
      padding-block-start: 1.875rem;
      border-block-start: 1px solid var(--hairline);
    }

    .role {
      font-size: 1.5rem;
    }

    .role:lang(en) {
      font-size: 1.625rem;
    }

    .profile-links {
      grid-column: 5;
      grid-row: 6;
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .language-switch a {
      transition: none;
    }
  }
</style>
