---
import Page from '../layouts/Page.astro';
import { supportedLanguages } from '../lib/i18n/constants';
import { interfaceText, languageNames } from '../lib/i18n/interface-text';
import { pageMetadata } from '../lib/page-metadata';
---
<Page language="en" metadata={await pageMetadata(interfaceText.en.pageNames.notFound)} class="not-found">
  <div class="messages">
    {supportedLanguages.map((language, index) => {
      const Heading = index === 0 ? 'h1' : 'h2';
      return (
        <section lang={language}>
          <Heading class="heading">{interfaceText[language].pageNames.notFound}</Heading>
          <p class="explanation">{interfaceText[language].notFoundExplanation}</p>
        </section>
      );
    })}
  </div>
  <ul class="home-links links-on-rule" role="list">
    {supportedLanguages.map((language) => (
      <li lang={language}>
        <a href={`/${language}/`} hreflang={language}>
          {interfaceText[language].homeLinkLabel({ languageName: languageNames[language] })}
        </a>
      </li>
    ))}
  </ul>
</Page>

<style>
  :global(main.not-found) {
    --columns-gap: clamp(2rem, 6vw, 5rem);
    max-width: 64rem;
    margin: 0;
    padding: clamp(4rem, 14svh, 8rem) var(--gutter) 3rem;
    overflow-wrap: normal;
  }

  :global(main.not-found)::before {
    content: "";
    display: block;
    block-size: 0.875rem;
    inline-size: min(70%, 36rem + var(--gutter));
    margin-inline-start: calc(-1 * var(--gutter));
    margin-block-end: 2.5rem;
    background: var(--type);
  }

  .messages,
  .home-links {
    display: grid;
    column-gap: var(--columns-gap);
  }

  .messages {
    row-gap: 2rem;
  }

  .heading {
    margin: 0;
    font-family: var(--latin);
    font-size: clamp(1.75rem, 1.25rem + 2.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--type);
  }

  .heading:lang(ja) {
    font-family: var(--japanese);
    font-size: clamp(1.625rem, 1.2rem + 1.9vw, 2.5rem);
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: none;
  }

  .explanation {
    margin: 1rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--body);
  }

  .explanation:lang(ja) {
    font-size: 1rem;
    line-height: 1.95;
    word-break: auto-phrase;
  }

  .home-links {
    margin-block-start: 2.5rem;
  }

  @media (min-width: 48rem) {
    :global(main.not-found)::before {
      inline-size: calc(var(--gutter) + (100% - var(--columns-gap)) / 2);
    }

    .messages,
    .home-links {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 80rem) {
    :global(main.not-found)::before {
      block-size: 1.375rem;
    }
  }
</style>
