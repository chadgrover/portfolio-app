---
import githubInvertocat from '../assets/profile-link-marks/GitHub_Invertocat_White.svg?raw';
import linkedinInBug from '../assets/profile-link-marks/InBug-White.png';
import type { ProfileLinkId } from '../lib/portfolio-content/schema';

interface Props {
  profileLinkId: ProfileLinkId;
}

const officialMarks: Record<ProfileLinkId, { svg: string } | { image: ImageMetadata }> = {
  github: { svg: githubInvertocat },
  linkedin: { image: linkedinInBug },
};

const { profileLinkId } = Astro.props;
const mark = officialMarks[profileLinkId];
---
{'svg' in mark
  ? <span class="profile-link-mark" aria-hidden="true" set:html={mark.svg} />
  : <img class="profile-link-mark" src={mark.image.src} width={mark.image.width} height={mark.image.height} alt="" />}

<style>
  .profile-link-mark {
    display: block;
    flex: none;
    block-size: var(--profile-link-mark-size);
    inline-size: auto;
  }

  .profile-link-mark :global(svg) {
    display: block;
    block-size: 100%;
    inline-size: auto;
  }
</style>
