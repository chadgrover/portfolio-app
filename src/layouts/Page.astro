---
import type { Language } from '../lib/i18n/types';
import { fontFaceCss } from '../lib/fonts/faces';
import type { PageMetadata } from '../lib/page-metadata';
import '../styles/global.css';
interface Props {
  language: Language;
  metadata: PageMetadata;
  class?: string;
  style?: string;
}
const { language, metadata, class: mainClass, style: mainStyle } = Astro.props;
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0e12" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{metadata.title}</title>
    {metadata.description && <meta name="description" content={metadata.description} />}
    {Astro.site && (
      <>
        {metadata.canonicalPath && <link rel="canonical" href={new URL(metadata.canonicalPath, Astro.site).href} />}
        {metadata.languageLinkPaths && Object.entries(metadata.languageLinkPaths).map(([hreflang, path]) => (
          <link rel="alternate" hreflang={hreflang} href={new URL(path, Astro.site).href} />
        ))}
      </>
    )}
    <style is:inline set:html={fontFaceCss}></style>
    <slot name="head" />
  </head>
  <body><slot name="header" /><main class={mainClass} style={mainStyle}><slot /></main></body>
</html>
